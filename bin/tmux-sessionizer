#!/usr/bin/env bash
# ============================================================================
#  tmux-sessionizer — session switcher con fzf para tmux
#  Bindeado a: prefix + C-j (Ctrl+Space C-j)
#
#  Diseñado para correr DENTRO de un display-popup de tmux.
#  Por eso usa fzf plano (NO fzf-tmux) — no se pueden anidar popups.
# ============================================================================

# Detectar si hay servidor tmux corriendo (más robusto que chequear $TMUX,
# que puede no heredarse correctamente en algunos contextos de display-popup).
if ! tmux info >/dev/null 2>&1; then
    echo "tmux server no está corriendo"
    exit 1
fi

# Lista las sesiones existentes, le pasa a fzf, y captura la elegida.
# Usamos fzf plano (no fzf-tmux) porque ya estamos dentro de un popup.
selected=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | \
    fzf --prompt "  Switch session > " \
        --header "Enter: ir | Esc: cancelar | Tipear nombre nuevo + Enter: crear" \
        --print-query \
        --expect=enter \
    | tail -n +2)

# fzf con --print-query devuelve 2 líneas:
# 1) lo que tipeaste
# 2) lo que seleccionaste de la lista (puede estar vacío si tipeaste algo nuevo)
query=$(echo "$selected" | head -n 1)
match=$(echo "$selected" | tail -n 1)

# Si seleccionaste algo de la lista, usá eso
# Si no, usá lo que tipeaste como nombre nuevo
target="${match:-$query}"

# Si no hay nada (Esc), salir
[ -z "$target" ] && exit 0

# Si la sesión existe, cambiar a ella; si no, crearla
if tmux has-session -t="$target" 2>/dev/null; then
    tmux switch-client -t "$target"
else
    tmux new-session -d -s "$target"
    tmux switch-client -t "$target"
fi
